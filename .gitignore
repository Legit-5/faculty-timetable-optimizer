# ============================================================
# Faculty Timetable Optimizer — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables ────────────────────────────────────
.env
.env.*
!.env.example

# ── Flask / Web ──────────────────────────────────────────────
instance/
.flaskenv
*.log

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing & Coverage ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Misc ─────────────────────────────────────────────────────
*.tmp
*.bak
"New Text Document.txt"
